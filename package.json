{
  "name": "@antongolub/artel",
  "version": "0.0.1",
  "description": "Multi-agent orchestration research — coordination layer for CLI agents.",
  "license": "MIT",
  "author": "Anton Golub <antongolub@antongolub.com>",
  "homepage": "https://github.com/antongolub/artel#readme",
  "bugs": {
    "url": "https://github.com/antongolub/artel/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antongolub/artel.git"
  },
  "keywords": [
    "multi-agent",
    "orchestration",
    "agentic",
    "research",
    "claude",
    "codex",
    "copilot",
    "cli",
    "event-sourcing",
    "uuid-v7"
  ],
  "type": "module",
  "bin": {
    "artel": "engine/cli/artel.mjs"
  },
  "files": [
    "engine",
    "agents",
    "skills",
    "AGENTS.md",
    "CHALLENGE.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm test && npm run typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.9"
  }
}
